# Copy to .env.local and fill in. See lib/env.ts for validation rules.
# In SOURCES_MODE=mock only the Supabase vars are required.

# --- Public (safe for the browser) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (only for local `supabase start`; hosted projects set this in the dashboard)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Server only ---
SUPABASE_SERVICE_KEY=

# mock | live. Mock reads /fixtures with simulated latency and failures.
SOURCES_MODE=mock
APP_TIMEZONE=America/Chicago

# Shared secret (>=16 chars) guarding POST /api/extract
EXTRACT_INTERNAL_KEY=

# --- Required only when SOURCES_MODE=live ---
GROQ_API_KEY=            # Llama vision extraction
EMBEDDINGS_API_KEY=      # 768-dim embeddings for dedupe (provider TBD)
META_IG_USER_ID=         # Instagram Business account id (Business Discovery)
META_LONG_LIVED_TOKEN=   # Refreshed monthly by the refresh-token job
APIFY_TOKEN=             # Personal-account fallback
NEBULA_API_KEY=          # Courses and rooms
RESEND_API_KEY=          # Warnings and digest email
