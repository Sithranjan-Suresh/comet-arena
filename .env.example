# Copy to .env.local and fill in. See lib/env.ts for validation rules.
# In SOURCES_MODE=mock only the Supabase vars are required.

# --- Public (safe for the browser) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (only for local `supabase start`; hosted projects set this in the dashboard)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Server only ---
SUPABASE_SERVICE_KEY=

# mock | live. Mock reads /fixtures with simulated latency and failures.
SOURCES_MODE=mock
APP_TIMEZONE=America/Chicago

# Shared secret (>=16 chars) guarding POST /api/extract
EXTRACT_INTERNAL_KEY=

# Secret (>=16 chars) that signs unsubscribe links. Rotating it invalidates old email links.
UNSUBSCRIBE_SECRET=

# --- Required only when SOURCES_MODE=live ---
GROQ_API_KEY=            # Vision extraction
GROQ_VISION_MODEL=       # optional, default qwen/qwen3.8-27b
GROQ_MAX_IMAGES=         # optional, default 3 (Groq's per-request limit for that model)
EMBEDDINGS_API_KEY=      # 768-dim embeddings for dedupe
EMBEDDINGS_BASE_URL=     # optional, default https://api.openai.com/v1 (any OpenAI-compatible provider)
EMBEDDINGS_MODEL=        # optional, default text-embedding-3-small (called with dimensions=768)
META_IG_USER_ID=         # Instagram Business account id (Business Discovery)
META_LONG_LIVED_TOKEN=   # Refreshed monthly by the refresh-token job
APIFY_TOKEN=             # Personal-account fallback
META_APP_ID=           # Meta app id (token refresh)
META_APP_SECRET=       # Meta app secret (token refresh)
GH_SECRETS_TOKEN=      # GitHub PAT allowed to update Actions secrets (token refresh write-back)
NEBULA_API_KEY=          # Courses and rooms
NEBULA_BASE_URL=       # Optional override of the Nebula API base URL
UTDCLUBS_BASE_URL=     # Optional override of the UTD Clubs API base URL
CAMPUSGROUPS_ICAL_URL= # Public CampusGroups iCal feed for events
INBOUND_EMAIL_SECRET=  # Shared secret the inbound-email provider sends to /api/inbound/email
INBOUND_SENDERS=       # Extra allowed newsletter senders (comma-separated addresses or domains)
NEXT_PUBLIC_CONTACT_EMAIL= # Shown on the privacy page
DISCORD_WEBHOOK_URL=   # Incoming webhook of the channel for new-game and deadline alerts
VAPID_PUBLIC_KEY=      # Web push keys: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=         # mailto:you@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY= # Same value as VAPID_PUBLIC_KEY, for the browser
RESEND_API_KEY=          # Warnings and digest email
EMAIL_FROM=              # Verified sender, e.g. "Comet Arena <alerts@mail.yourdomain.com>"
ADMIN_EMAIL=           # Gets an email when a scheduled job fails

# Demo safety net: serve the pre-extracted result for the demo flyer instantly (1) instead of calling the model.
DEMO_CACHE=
