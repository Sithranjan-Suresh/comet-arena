{
  "name": "comet-arena",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "prettier --check . && eslint && tsc --noEmit && vitest run && next build",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:test": "scripts/db-test.sh test",
    "db:types": "node scripts/gen-db-types.mjs",
    "fixtures:flyers": "tsx scripts/gen-fixture-flyers.mts",
    "job:send-warnings": "tsx --env-file-if-exists=.env.local jobs/send-warnings.mts",
    "job:send-digest": "tsx --env-file-if-exists=.env.local jobs/send-digest.mts",
    "job:notify-changes": "tsx --env-file-if-exists=.env.local jobs/notify-changes.mts",
    "job:expire-past": "tsx --env-file-if-exists=.env.local jobs/expire-past.mts",
    "eval": "tsx --env-file-if-exists=.env.local scripts/eval.mts",
    "eval:dedupe": "tsx --env-file-if-exists=.env.local scripts/eval-dedupe.mts",
    "eval:gate": "tsx scripts/eval-gate.mts",
    "check:bundle": "node scripts/check-bundle.mjs",
    "eval:validate": "tsx scripts/eval-validate.mts",
    "eval:seed": "tsx scripts/eval-seed-from-fixtures.mts",
    "eval:scaffold": "tsx --env-file-if-exists=.env.local scripts/eval-scaffold.mts",
    "job:sync-orgs": "tsx --env-file-if-exists=.env.local jobs/sync-orgs.mts",
    "job:ingest-instagram": "tsx --env-file-if-exists=.env.local jobs/ingest-instagram.mts",
    "job:classify-accounts": "tsx --env-file-if-exists=.env.local jobs/classify-accounts.mts",
    "job:rededupe": "tsx --env-file-if-exists=.env.local jobs/rededupe.mts",
    "job:refresh-token": "tsx --env-file-if-exists=.env.local jobs/refresh-token.mts",
    "job:ingest-feeds": "tsx --env-file-if-exists=.env.local jobs/ingest-feeds.mts",
    "seed:orgs": "tsx --env-file-if-exists=.env.local supabase/seed/orgs.mts",
    "seed:competitions": "tsx --env-file-if-exists=.env.local supabase/seed/competitions.mts",
    "db:reset:local": "scripts/db-test.sh reset"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "heic2any": "^0.0.4",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/js-yaml": "^4.0.9",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "ical.js": "^2.2.1",
    "js-yaml": "^5.5.0",
    "jsdom": "^31.0.0",
    "libsodium-wrappers": "^0.7.15",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
